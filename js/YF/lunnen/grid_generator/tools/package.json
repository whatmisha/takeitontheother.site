{
  "name": "lunnen-grid-generator-tools",
  "version": "1.12.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.js",
    "build": "npm run schema:check && vite build --config vite.config.js",
    "preview": "vite preview --config vite.config.js",
    "test": "npm run schema:check && node --test ../tests/*.test.mjs",
    "schema": "node generate-preset-validator.js",
    "schema:check": "node generate-preset-validator.js --check",
    "presets": "node generate-presets-manifest.js",
    "presets:check": "node generate-presets-manifest.js --check"
  },
  "dependencies": {
    "jspdf": "4.2.1",
    "opentype.js": "1.3.4",
    "svg2pdf.js": "2.7.0"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "vite": "7.3.6"
  }
}
