{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunnen.local/schemas/preset-2.0.schema.json",
  "title": "Pizza Boxer 02 packaging document 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "presetName",
    "version",
    "dimensions",
    "surfaces",
    "texts",
    "grid",
    "colors",
    "typography",
    "display",
    "graphics",
    "construction"
  ],
  "properties": {
    "presetName": {
      "type": "string"
    },
    "version": {
      "const": "2.0"
    },
    "timestamp": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "depth",
        "unit"
      ],
      "properties": {
        "width": {
          "$ref": "#/$defs/positiveDimension"
        },
        "height": {
          "$ref": "#/$defs/positiveDimension"
        },
        "unit": {
          "const": "mm"
        },
        "depth": {
          "$ref": "#/$defs/positiveDimension"
        }
      }
    },
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "front": {
          "$ref": "#/$defs/surface"
        },
        "left": {
          "$ref": "#/$defs/surface"
        },
        "right": {
          "$ref": "#/$defs/surface"
        },
        "top": {
          "$ref": "#/$defs/surface"
        },
        "bottom": {
          "$ref": "#/$defs/surface"
        },
        "base": {
          "$ref": "#/$defs/surface"
        },
        "flap": {
          "$ref": "#/$defs/surface"
        },
        "tubeCap": {
          "$ref": "#/$defs/surface"
        }
      }
    },
    "texts": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/textBlock"
      }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "margins",
        "marginsUnit",
        "columns",
        "rows",
        "rowHeight",
        "locks",
        "visibility"
      ],
      "properties": {
        "module": {
          "$ref": "#/$defs/positiveGridNumber"
        },
        "margins": {
          "$ref": "#/$defs/nonNegativeGridNumber"
        },
        "marginsUnit": {
          "$ref": "#/$defs/gridUnit"
        },
        "columns": {
          "$ref": "#/$defs/gridCount"
        },
        "rows": {
          "$ref": "#/$defs/gridCount"
        },
        "rowHeight": {
          "$ref": "#/$defs/positiveGridNumber"
        },
        "linkMode": {
          "enum": [
            "off",
            "rows-height",
            "module"
          ]
        },
        "locks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "module",
            "margins",
            "moduleValue",
            "marginsValue"
          ],
          "properties": {
            "module": {
              "type": "boolean"
            },
            "margins": {
              "type": "boolean"
            },
            "moduleValue": {
              "$ref": "#/$defs/nullableNonNegativeGridNumber"
            },
            "marginsValue": {
              "$ref": "#/$defs/nullableNonNegativeGridNumber"
            }
          }
        },
        "visibility": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "columns": {
              "type": "boolean"
            },
            "rows": {
              "type": "boolean"
            },
            "baseline": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "units",
        "headline",
        "text",
        "caption",
        "lunnenDisplay"
      ],
      "properties": {
        "units": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "lineHeight"
          ],
          "properties": {
            "size": {
              "enum": [
                "mod",
                "pt"
              ]
            },
            "lineHeight": {
              "enum": [
                "mod",
                "pt"
              ]
            }
          }
        },
        "headline": {
          "$ref": "#/$defs/typographyStyleWithWeight"
        },
        "text": {
          "$ref": "#/$defs/typographyStyleWithWeight"
        },
        "caption": {
          "$ref": "#/$defs/typographyStyleWithWeight"
        },
        "lunnenDisplay": {
          "$ref": "#/$defs/typographyStyle"
        },
        "customStyles": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/customTextStyle"
          }
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dimensions": {
          "type": "boolean"
        },
        "labels": {
          "type": "boolean"
        },
        "sidePanels": {
          "type": "boolean"
        },
        "objects": {
          "type": "boolean"
        }
      }
    },
    "graphics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocks",
        "icons",
        "claim"
      ],
      "properties": {
        "blocks": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/graphicBlock"
          }
        },
        "icons": {
          "anyOf": [
            {
              "$ref": "#/$defs/builtInGraphic"
            },
            {
              "type": "null"
            }
          ]
        },
        "claim": {
          "anyOf": [
            {
              "$ref": "#/$defs/builtInGraphic"
            },
            {
              "type": "null"
            }
          ]
        },
        "claim2026": {
          "anyOf": [
            {
              "$ref": "#/$defs/builtInGraphic"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "construction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "flapDepth"
      ],
      "properties": {
        "type": {
          "enum": [
            "lid",
            "box",
            "tuck-box",
            "tube",
            "telescopic-tube"
          ]
        },
        "flapDepth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "tube": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tubeDiameter",
            "tubeBodyHeight",
            "tubeCapHeight",
            "tubeOverlap",
            "tubeWall",
            "tubeClearance"
          ],
          "properties": {
            "tubeDiameter": {
              "type": "number",
              "minimum": 10,
              "maximum": 500
            },
            "tubeBodyHeight": {
              "type": "number",
              "minimum": 10,
              "maximum": 1000
            },
            "tubeCapHeight": {
              "type": "number",
              "minimum": 5,
              "maximum": 1000
            },
            "tubeOverlap": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            },
            "tubeWall": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 10
            },
            "tubeClearance": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            }
          }
        },
        "boxDimensions": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "frontWidth",
                "frontHeight",
                "thickness"
              ],
              "properties": {
                "frontWidth": {
                  "$ref": "#/$defs/positiveDimension"
                },
                "frontHeight": {
                  "$ref": "#/$defs/positiveDimension"
                },
                "thickness": {
                  "$ref": "#/$defs/positiveDimension"
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "tube",
                  "telescopic-tube"
                ]
              }
            }
          },
          "then": {
            "required": [
              "tube"
            ],
            "properties": {
              "tube": {}
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "positiveDimension": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10000
    },
    "nonNegativeDimension": {
      "type": "number",
      "minimum": 0,
      "maximum": 10000
    },
    "positiveGridNumber": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10000
    },
    "nonNegativeGridNumber": {
      "type": "number",
      "minimum": 0,
      "maximum": 10000
    },
    "nullableNonNegativeGridNumber": {
      "anyOf": [
        {
          "$ref": "#/$defs/nonNegativeGridNumber"
        },
        {
          "type": "null"
        }
      ]
    },
    "gridCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "gridUnit": {
      "enum": [
        "mod",
        "mm"
      ]
    },
    "surfaceId": {
      "enum": [
        "front",
        "left",
        "right",
        "top",
        "bottom",
        "base",
        "flap",
        "tubeCap"
      ]
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "column",
        "row",
        "baseline"
      ],
      "properties": {
        "column": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "row": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "baseline": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "surfaceGrid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "margins",
        "columns",
        "rows",
        "rowHeight"
      ],
      "properties": {
        "module": {
          "$ref": "#/$defs/positiveGridNumber"
        },
        "margins": {
          "$ref": "#/$defs/nonNegativeGridNumber"
        },
        "columns": {
          "$ref": "#/$defs/gridCount"
        },
        "rows": {
          "$ref": "#/$defs/gridCount"
        },
        "rowHeight": {
          "$ref": "#/$defs/positiveGridNumber"
        },
        "marginsUnit": {
          "$ref": "#/$defs/gridUnit"
        },
        "lockedModule": {
          "type": "boolean"
        },
        "lockedMargins": {
          "type": "boolean"
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visible",
        "rotation",
        "gridMode"
      ],
      "properties": {
        "visible": {
          "type": "boolean"
        },
        "rotation": {
          "enum": [
            0,
            90,
            180,
            270
          ]
        },
        "gridMode": {
          "enum": [
            "main",
            "own"
          ]
        },
        "grid": {
          "$ref": "#/$defs/surfaceGrid"
        }
      }
    },
    "textBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "content",
        "style",
        "position",
        "width",
        "alignment",
        "textAlign",
        "alignmentMode",
        "surface",
        "showBounds",
        "visible",
        "lockPosition"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "style": {
          "anyOf": [
            {
              "enum": [
                "headline",
                "text",
                "caption",
                "lunnenDisplay"
              ]
            },
            {
              "type": "string",
              "pattern": "^custom-[A-Za-z0-9-]{1,80}$"
            }
          ]
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "alignment": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "textAlign": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "alignmentMode": {
          "enum": [
            "baseline",
            "x-height",
            "cap-height"
          ]
        },
        "surface": {
          "$ref": "#/$defs/surfaceId"
        },
        "showBounds": {
          "type": "boolean"
        },
        "visible": {
          "type": "boolean"
        },
        "lockPosition": {
          "type": "boolean"
        },
        "layer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "fontWeight": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        },
        "fontFeatures": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "salt": {
              "type": "boolean"
            },
            "aalt": {
              "type": "boolean"
            },
            "ss01": {
              "type": "boolean"
            },
            "ss02": {
              "type": "boolean"
            },
            "tnum": {
              "type": "boolean"
            },
            "dlig": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "typographyStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "lineHeight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "tracking": {
          "type": "number",
          "minimum": -10,
          "maximum": 10
        },
        "useXHeight": {
          "type": "boolean"
        }
      }
    },
    "typographyStyleWithWeight": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "lineHeight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "tracking": {
          "type": "number",
          "minimum": -10,
          "maximum": 10
        },
        "useXHeight": {
          "type": "boolean"
        },
        "fontWeight": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "graphicCore": {
      "type": "object",
      "required": [
        "position",
        "height",
        "sizeMode",
        "alignment",
        "surface",
        "showBounds",
        "visible",
        "lockPosition",
        "svg"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/position"
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "widthInColumns": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10000
            },
            {
              "type": "null"
            }
          ]
        },
        "widthInModules": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10000
            },
            {
              "type": "null"
            }
          ]
        },
        "sizeMode": {
          "enum": [
            "height",
            "width"
          ]
        },
        "originalWidth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        },
        "originalHeight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        },
        "alignment": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "surface": {
          "$ref": "#/$defs/surfaceId"
        },
        "showBounds": {
          "type": "boolean"
        },
        "visible": {
          "type": "boolean"
        },
        "lockPosition": {
          "type": "boolean"
        },
        "layer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "svg": {
          "type": "string"
        },
        "missingAsset": {
          "type": "boolean"
        },
        "raster": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dataUrl",
            "width",
            "height"
          ],
          "properties": {
            "dataUrl": {
              "type": "string",
              "maxLength": 2000000,
              "pattern": "^(data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+)?$"
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100000
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100000
            },
            "fit": {
              "enum": [
                "cover",
                "contain"
              ]
            }
          }
        },
        "markings": {
          "$ref": "#/$defs/markingGroup"
        }
      }
    },
    "graphicBlock": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/graphicCore"
        },
        {
          "type": "object",
          "required": [
            "id",
            "name"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "builtInGraphic": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/graphicCore"
        }
      ],
      "unevaluatedProperties": false
    },
    "customTextStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size",
        "lineHeight",
        "tracking",
        "useXHeight",
        "fontWeight",
        "id",
        "name",
        "fontFamily"
      ],
      "properties": {
        "size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "lineHeight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "tracking": {
          "type": "number",
          "minimum": -10,
          "maximum": 10
        },
        "useXHeight": {
          "type": "boolean"
        },
        "fontWeight": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        },
        "id": {
          "type": "string",
          "pattern": "^custom-[A-Za-z0-9-]{1,80}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "fontFamily": {
          "enum": [
            "TT Commons Classic",
            "Lunnen Display"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "fontFamily": {
                "const": "Lunnen Display"
              }
            }
          },
          "then": {
            "properties": {
              "fontWeight": {
                "minimum": 100,
                "maximum": 400,
                "type": "number"
              }
            }
          },
          "else": {
            "properties": {
              "fontWeight": {
                "enum": [
                  400,
                  500
                ]
              }
            }
          }
        }
      ]
    },
    "markingGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "items",
        "direction",
        "gap",
        "align"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "enabled"
            ],
            "properties": {
              "id": {
                "enum": [
                  "eac-v1",
                  "manual-v1",
                  "fragile-v1",
                  "keep-dry-v1",
                  "pap21-v1",
                  "pap20-v1",
                  "weee-v1"
                ]
              },
              "enabled": {
                "type": "boolean"
              }
            }
          }
        },
        "direction": {
          "enum": [
            "row",
            "column"
          ]
        },
        "gap": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "align": {
          "enum": [
            "start",
            "center",
            "end"
          ]
        }
      }
    }
  }
}
